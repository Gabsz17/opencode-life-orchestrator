{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "life-orchestrator",
  "model": "anthropic/claude-sonnet-4-5",
  "permission": {
    // BASE SEGURA: grants globais ja negam os artefatos de GOVERNANCA (agents/, scripts/,
    // configs, .git, .env) — mesmo que a sua versao do OpenCode NAO aplique o override por
    // agente (permission de agents/*.md), ninguem reescreve a propria estrutura de permissoes.
    // Cada agente em agents/*.md tem permission proprio, sempre igual ou MAIS restritivo.
    "edit": {
      "*": "allow",
      ".env": "deny",
      "agents/*": "deny",
      "scripts/*": "deny",
      "opencode.jsonc": "deny",
      ".git/*": "deny",
      ".github/*": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * --delete*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "question": "deny"
  },
  "agent": {
    "life-orchestrator": { "primary": true },
    "orquestrador": { "primary": true },
    "mentor": { "primary": true }
  },
  "mcp": {
    "context7": { "type": "local", "command": ["npx", "-y", "@upstash/context7-mcp"], "enabled": true }
  },
  "instructions": ["docs/estudos/disclaimer.md", "docs/ganhos/disclaimer.md", "docs/shared/memoria-guia.md"]
}
